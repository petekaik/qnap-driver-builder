# Build-time environment for the QNAP driver builder.
# Paths are CONTAINER-absolute (the Dockerfile copies the repo to /build).
# Copy to .env before running the builder:  cp .env.example .env
BASE_DIR=/build
SRC_DIR=/build/src
CONFIG_DIR=/build/config
PATCH_DIR=/build/patches
OUT_DIR=/build/out

# Driver families to build, by manifest directory name under drivers/.
DRIVERS="dvb usb-serial"

# Target device / QTS release. Must match the running kernel on the NAS.
QNAP_DEVICE=TS-X51
QNAP_VER=5.2.3.20250218
QNAP_DIR=/build/src/GPL_QTS

KERNEL_VER=5.10
KERNEL_DIR=/build/src/GPL_QTS/src/linux-5.10
QNAP_KERNEL_CONFIG_FILE=/build/src/GPL_QTS/kernel_cfg/TS-X51/linux-5.10-x86_64.config

# Deploy target for scripts/deploy-to-nas.sh.
#
# Unlike everything above, these are NAS-side values, not container paths: the
# builder container never reads them. DEPLOY_HOST is an ssh destination — a
# ~/.ssh/config alias is the safest form, so no address is written down here
# (and .env stays out of the repo and out of the build context's .dockerignore).
# DEPLOY_DIR is the directory on the NAS the boot path reads.
DEPLOY_HOST=user@qnap-nas
DEPLOY_DIR=/share/<volume>/qnap-driver-builder
