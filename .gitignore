# ---------------------------------------------------------------------------
# Host state — never committed. See README "Installing the modules".
# ---------------------------------------------------------------------------
# Build-time environment. Secrets/locally-specific paths live here.
# Ship .env.example instead; the container sources .env, so it must NOT be
# listed in .dockerignore.
.env
.env.local
!.env.example

# Downloaded QNAP GPL kernel source and the extracted tree (several GB).
src/

# Build outputs.
modules/
*.ko
logs/

# Downloaded firmware (dvb-demod-si2168-*.fw). Never vendored — see README.
firmware/

# ---------------------------------------------------------------------------
# Build/interchange junk.
# ---------------------------------------------------------------------------
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.bak
*.backup
*.log
*.tmp
*.swp
*~

# OS files.
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
